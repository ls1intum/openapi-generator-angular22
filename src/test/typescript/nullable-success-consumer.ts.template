export function checkedResource(resource: ReturnType<typeof resources.getMixedResource>): string {
    const value = resource.value();
    // @ts-expect-error Resource values require null and undefined checks.
    value.id;
    if (value === undefined) return 'loading';
    // @ts-expect-error Excluding undefined still leaves the successful null result.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}
export function checkedOmittedSchemaResource(resource: ReturnType<typeof resources.getOmittedSchemaResource>): string {
    const value = resource.value();
    if (value === undefined) return 'loading';
    // @ts-expect-error An omitted JSON schema still permits a successful null value.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}
export function checkedUnknownResource(resource: ReturnType<typeof resources.getUnknownSuccessResource>): string {
    const value = resource.value();
    if (value === undefined) return 'loading';
    // @ts-expect-error Excluding loading state does not establish the arbitrary JSON body's shape.
    value.id;
    return checkedUnknown(value);
}
