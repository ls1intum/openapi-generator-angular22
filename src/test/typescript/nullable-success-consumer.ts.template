import type { HttpResourceRef } from '@angular/common/http';
import * as resources from '@RESOURCE_MODULE@';

type Value<K extends keyof typeof resources> = (typeof resources)[K] extends (...args: never[]) => HttpResourceRef<infer V> ? V : never;
export type ResourceContracts = [
    Assert<Equal<Value<'getMixedResource'>, Job | null | undefined>>,
    Assert<Equal<ReturnType<typeof resources.getMixedResource>, HttpResourceRef<Job | null | undefined>>>,
    Assert<Equal<Value<'getMixedReversedResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getAcceptedResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getBodylessFirstResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getHeaderBodylessFirstResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getHeaderBodylessFirstReversedResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getDifferentSuccessBodiesResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getOtherResource'>, Other | null | undefined>>,
    Assert<Equal<Value<'getNullableCaseResource'>, CaseInfo | null | undefined>>,
    Assert<Equal<Value<'getNullableReferenceResource'>, NullableReference | null | undefined>>,
    Assert<Equal<Value<'getNullableInlineResource'>, { readonly id: string } | null | undefined>>,
    Assert<Equal<Value<'getNullableScalarResource'>, number | null | undefined>>,
    Assert<Equal<Value<'getNullableJsonStringResource'>, string | null | undefined>>,
    Assert<Equal<Value<'getNullableArrayResource'>, Array<Payload> | null | undefined>>,
    Assert<Equal<Value<'getNullableMapResource'>, { [key: string]: Payload } | null | undefined>>,
    Assert<Equal<Value<'getNullableItemsResource'>, Array<string | null> | undefined>>,
    Assert<Equal<Value<'getNullableItemsAndRootResource'>, Array<string | null> | null | undefined>>,
    Assert<Equal<Value<'getNullableValuesResource'>, { [key: string]: number | null } | undefined>>,
    Assert<Equal<Value<'getNonNullResource'>, Payload | undefined>>,
    Assert<Equal<Value<'getErrorOnlyResource'>, Payload | undefined>>,
    Assert<Equal<Value<'getUnconstrainedSuccessResource'>, Payload | undefined>>,
    Assert<Equal<Value<'getRecursiveResource'>, RecursivePayload | undefined>>,
    Assert<Equal<Value<'getIntersectionResource'>, NonNullIntersection | undefined>>,
    Assert<Equal<Value<'getHeaderMixedResource'>, Job | null | undefined>>,
    Assert<Equal<Value<'getHeaderNullableResource'>, CaseInfo | null | undefined>>,
    Assert<Equal<Value<'getBinaryResource'>, Blob | undefined>>,
    Assert<Equal<Value<'getTextResource'>, string | undefined>>,
    Assert<Equal<Value<'getBooleanResource'>, boolean | undefined>>,
    Assert<Equal<Value<'getNumberResource'>, number | undefined>>,
    Assert<Equal<Value<'getArrayResource'>, Array<Payload> | undefined>>
];

export function checkedResource(resource: ReturnType<typeof resources.getMixedResource>): string {
    const value = resource.value();
    // @ts-expect-error Resource values require null and undefined checks.
    value.id;
    if (value === undefined) return 'loading';
    // @ts-expect-error Excluding undefined still leaves the successful null result.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}
// RESOURCES_END
