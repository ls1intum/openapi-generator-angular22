type Emission<T> = T extends Observable<infer V> ? V : never;
type Result<K extends keyof NullableApi> = NullableApi[K] extends (...args: never[]) => infer R ? Emission<R> : never;
type IsAny<T> = 0 extends (1 & T) ? true : false;
type Equal<A, B> = IsAny<A> extends true ? false :
    (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false;
type Assert<T extends true> = T;

// Equality also rejects unintended null/undefined and any, rather than merely accepting assignments.
export const omittedSchemaNull: Result<'getOmittedSchema'> = null;
// @ts-expect-error Observable emissions do not include resource loading state.
export const omittedSchemaUndefined: Result<'getOmittedSchema'> = undefined;
// @ts-expect-error Unconstrained error responses do not widen the selected success body.
export const omittedSchemaErrorNull: Result<'getOmittedSchemaError'> = null;

export function checkedOmittedSchema(value: Result<'getOmittedSchema'>): string {
    // @ts-expect-error A null check is required for unconstrained successful JSON content.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}

