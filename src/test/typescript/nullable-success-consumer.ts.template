export const unknownNull: Result<'getUnknownSuccess'> = null;
export const unknownObject: Result<'getUnknownSuccess'> = { id: 'ready' };
export const unknownArray: Result<'getUnknownSuccess'> = [1, 'ready', null];
export const unknownNumber: Result<'getUnknownSuccess'> = 0;
export const unknownBoolean: Result<'getUnknownSuccess'> = false;

export function checkedUnknown(value: Result<'getUnknownSuccess'>): string {
    // @ts-expect-error Arbitrary JSON cannot be consumed as a known DTO.
    value.id;
    if (value === null) return 'absent';
    // @ts-expect-error A null check alone does not validate the response shape.
    value.id;
    if (typeof value === 'object' && 'id' in value && typeof value.id === 'string') return value.id;
    return 'other';
}
