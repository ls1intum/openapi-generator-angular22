import type { HttpResourceRef } from '@angular/common/http';
import * as resources from '@RESOURCE_MODULE@';
type Value<K extends keyof typeof resources> = (typeof resources)[K] extends (...args: never[]) => HttpResourceRef<infer V> ? V : never;
export type ResourceContracts = [
    Assert<Equal<Value<'getTypeObjectResource'>, TypePayload | null | undefined>>,
    Assert<Equal<Value<'getInlineTypeResource'>, { readonly id: string } | null | undefined>>,
    Assert<Equal<Value<'getOneOfResource'>, Payload | null | undefined>>,
    Assert<Equal<Value<'getAnyOfResource'>, Payload | null | undefined>>,
    Assert<Equal<Value<'getInlineOneOfResource'>, Payload | null | undefined>>,
    Assert<Equal<Value<'getInlineAnyOfResource'>, Payload | null | undefined>>,
    Assert<Equal<Value<'getRootArrayResource'>, Array<Payload> | null | undefined>>,
    Assert<Equal<Value<'getRootMapResource'>, { [key: string]: number } | null | undefined>>,
    Assert<Equal<Value<'getRootScalarResource'>, boolean | null | undefined>>,
    Assert<Equal<Value<'getUnionResource'>, Choice | undefined>>,
    Assert<Equal<Value<'getJsonNullResource'>, null | undefined>>,
    Assert<Equal<Value<'getJsonNullWithHeadersResource'>, null | undefined>>,
    Assert<Equal<Value<'getNonNullResource'>, Payload | undefined>>,
    Assert<Equal<Value<'getNullableItemsResource'>, Array<string | null> | undefined>>,
    Assert<Equal<Value<'getIntersectionResource'>, NonNullIntersection | undefined>>
];

export function checkedNormalizedResource(resource: ReturnType<typeof resources.getOneOfResource>): string {
    const value = resource.value();
    // @ts-expect-error Both null and undefined are present in the normalized resource contract.
    value.id;
    if (value === undefined) return 'loading';
    // @ts-expect-error Checking the loading state alone does not exclude a successful null.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}
// RESOURCES_END
