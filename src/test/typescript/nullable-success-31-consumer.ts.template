import type { Observable } from 'rxjs';
import type { NormalizedApi } from './api/normalized-api';
import type { @Payload@ as Payload } from './model/@PayloadFile@';
import type { @TypePayload@ as TypePayload } from './model/@TypePayloadFile@';
import type { @Choice@ as Choice } from './model/@ChoiceFile@';
import type { @OtherPayload@ as OtherPayload } from './model/@OtherPayloadFile@';
import type { @NonNullIntersection@ as NonNullIntersection } from './model/@NonNullIntersectionFile@';

type Emission<T> = T extends Observable<infer V> ? V : never;
type Result<K extends keyof NormalizedApi> = NormalizedApi[K] extends (...args: never[]) => infer R ? Emission<R> : never;
type IsAny<T> = 0 extends (1 & T) ? true : false;
type Equal<A, B> = IsAny<A> extends true ? false :
    (<T>() => T extends A ? 1 : 2) extends (<T>() => T extends B ? 1 : 2) ? true : false;
type Assert<T extends true> = T;

export type ServiceContracts = [
    Assert<Equal<Result<'getTypeObject'>, TypePayload | null>>,
    Assert<Equal<Result<'getInlineType'>, { readonly id: string } | null>>,
    Assert<Equal<Result<'getOneOf'>, Payload | null>>,
    Assert<Equal<Result<'getAnyOf'>, Payload | null>>,
    Assert<Equal<Result<'getInlineOneOf'>, Payload | null>>,
    Assert<Equal<Result<'getInlineAnyOf'>, Payload | null>>,
    Assert<Equal<Result<'getRootArray'>, Array<Payload> | null>>,
    Assert<Equal<Result<'getRootMap'>, { [key: string]: number } | null>>,
    Assert<Equal<Result<'getRootScalar'>, boolean | null>>,
    Assert<Equal<Result<'getUnion'>, @HEADER_CHOICE@>>,
    Assert<Equal<Choice, Payload | OtherPayload | null>>,
    Assert<Equal<Result<'getJsonNull'>, null>>,
    Assert<Equal<Result<'getJsonNullWithHeaders'>, @HEADER_NULL@>>,
    Assert<Equal<Result<'getNonNull'>, Payload>>,
    Assert<Equal<Result<'getNullableItems'>, Array<string | null>>>,
    Assert<Equal<Result<'getIntersection'>, NonNullIntersection>>
];

export const missingOneOf: Result<'getOneOf'> = null;
export const missingAnyOf: Result<'getAnyOf'> = null;
// Normalized object aliases must also keep nullable members inside the non-null body.
export const nullableOneOfMembers: Result<'getOneOf'> = {
    id: 'one-of', note: null, sequence: null, tags: ['tag', null], scores: { score: null },
};
export const nullableAnyOfMembers: Result<'getAnyOf'> = {
    id: 'any-of', note: null, sequence: null, tags: ['tag', null], scores: { score: null },
};
export const jsonNull: Result<'getJsonNull'> = null;
// @ts-expect-error Explicit JSON null is not a void response.
export const jsonVoid: Result<'getJsonNull'> = undefined;
// @ts-expect-error Normalization must not make the ordinary referenced model nullable globally.
export const ordinaryNull: Result<'getNonNull'> = null;

export function checkedNormalized(value: Result<'getOneOf'>): string {
    // @ts-expect-error The normalized single-model-plus-null response requires a null check.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}

// HEADERS_START
import type { HttpResponse } from '@angular/common/http';
export type FullBodyContracts = [
    Assert<Equal<Result<'getJsonNullWithHeaders'>['body'], null>>,
    Assert<Equal<Result<'getUnion'>['body'], Choice>>
];
// HEADERS_END

