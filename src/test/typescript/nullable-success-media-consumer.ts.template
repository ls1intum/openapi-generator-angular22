export function checkedOmitted(value: Result<'getOmittedBeforeBody'>): string {
    // @ts-expect-error A body without a schema cannot be consumed as a known DTO.
    value.id;
    if (value === null) return 'absent';
    // @ts-expect-error A null check alone does not validate the response shape.
    value.id;
    if (typeof value === 'object' && 'id' in value && typeof value.id === 'string') return value.id;
    return 'other';
}

export function checkedRange(value: Result<'getRangeBeforeEmpty'>): string {
    // @ts-expect-error A 204 reaches a JSON call as null, whatever media type the 200 declares.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}

export function checkedLaterTextFirst(value: Result<'getLaterTextFirst'>): string {
    // @ts-expect-error The JSON entry of a later success permits null, whatever its position.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}

export function checkedSelectedTextFirst(value: Result<'getSelectedTextFirst'>): string {
    return value.id;
}

export function checkedDefault(value: Result<'getDefaultNullable'>): string {
    // @ts-expect-error A default response that types the method carries its null along.
    value.id;
    if (value === null) return 'absent';
    return value.id;
}

